{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AntiSpamBot": "Information"
    }
  },
  "AllowedHosts": "*",
  "DiscordBot": {
    "Token": "",
    "AdminChannelId": 0,
    "TimeoutDurationMinutes": 60
  },
  "SpamDetection": {
    "MessageHistoryDays": 7,
    "MinimumOldestMessageMinutes": 10,
    "MinimumChannelCount": 4
  }
}
